{
  "expo": {
    "name": "AyurSutra",
    "slug": "ayursutra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ayursutra",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ayursutra.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ayursutra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#43e97b",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ]
  }
}
